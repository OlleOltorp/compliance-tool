# Copy this file to .env and fill in what you need. .env is never committed.

# Turns on the AI judge. Create a key at https://platform.claude.com/ (Settings > API keys).
# Without a key the tool runs rules only.
ANTHROPIC_API_KEY=

# Optional: the model the AI judge uses (default claude-sonnet-5-5) and its effort (low, medium, high; default medium).
# LLM_MODEL=claude-sonnet-5-5
# LLM_EFFORT=medium

# Optional: use the Claude Code CLI instead of the API (needs Claude Code installed and signed in).
# LLM_BACKEND=cli

# Optional: turn the AI judge off even when a key is set.
# LLM_JUDGE=off
